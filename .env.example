# Copy to .env for local use. Never commit real values.

# Database container (docker-compose.yml)
POSTGRES_USER=processledger
POSTGRES_PASSWORD=processledger_dev
POSTGRES_DB=processledger
DB_HOST_PORT=5545

# Password given to the restricted application role created by migration 0002.
# The application connects as this role. It cannot bypass row level security.
APP_DB_PASSWORD=processledger_app_dev

# Application connection (restricted role, row level security enforced).
DATABASE_URL=postgresql+psycopg://processledger_app:processledger_app_dev@127.0.0.1:5545/processledger

# Migration connection (owner role). Used only by Alembic and seed scripts.
MIGRATION_DATABASE_URL=postgresql+psycopg://processledger:processledger_dev@127.0.0.1:5545/processledger

# Connection pool size for the application engine.
DB_POOL_SIZE=5
ENVIRONMENT=local

# --- Secrets (generate your own; the API refuses to start without them) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
EVIDENCE_ENCRYPTION_KEY=

# --- Authentication ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Keep true. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true

# --- HTTP hardening (list values are JSON) ---
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
LOGIN_RATE_LIMIT=5/minute
DEFAULT_RATE_LIMIT=120/minute

# --- Evidence ---
UPLOAD_DIR=./data/evidence
MAX_UPLOAD_BYTES=52428800
EVIDENCE_RETENTION_DAYS=365

# --- Website observation (server side request forgery protection) ---
# Hostnames the platform may observe. "*.example.test" matches subdomains only.
OBSERVATION_ALLOWED_HOSTS=[]
# Private ranges that are acceptable because they are the demo network.
OBSERVATION_ALLOWED_NETWORKS=[]
OBSERVATION_ALLOWED_PORTS=[80,443]
REA_BROWSER_TIMEOUT_SECONDS=60

# --- REA discovery (see docs/architecture.md) ---
REA_ENABLED=true
# local: run rea-runner/wrapper.mjs as a child process (needs `npm ci` in rea-runner and Node 24.15+)
# http: call the rea-offline and rea-browser containers
REA_TRANSPORT=local
REA_OFFLINE_URL=http://rea-offline:8080
REA_BROWSER_URL=http://rea-browser:8080
REA_RUNNER_TOKEN=
# Decrypted evidence is staged here for the duration of one call. In http mode this is the volume
# shared with the runners (mounted read only there).
REA_INPUT_DIR=./data/rea_input
REA_TIMEOUT_SECONDS=120
REA_OBSERVATION_MS=2500
SQLITE_ROW_SAMPLE=20

# --- Classification (see docs/architecture.md) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# true once the model is in the local cache or baked into the image (scripts/download_embedding_model.py)
EMBEDDING_LOCAL_FILES_ONLY=false

# --- Local demo accounts (scripts/seed_demo_users.py) ---
DEMO_PASSWORD=

# --- LLM router (see docs/architecture.md). Free tier content may be used by the provider:
# only masked metadata is sent. Without a key the provider is simply not registered. ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# Free models and quotas change often: confirm in Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_REQUEST_TOKEN_CAP=5000
LLM_MAX_OUTPUT_TOKENS=800
LLM_ONBOARDING_TOKEN_BUDGET=4000

# Date the review and retention checks count from (default: today). The demonstration estate was built for 2026-10-01.
# REFERENCE_DATE=2026-10-01
LLM_ASSESSMENT_TOKEN_BUDGET=6000

# --- Access requests ---
# Key for the HMAC of subject identifiers. If unset it is derived from EVIDENCE_ENCRYPTION_KEY.
# SUBJECT_HASH_KEY=
REQUEST_REMINDER_DAYS=7

# --- Background jobs (Phase 11) ---
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
# Run the stages inside the API process (tests, a laptop without Redis)
CELERY_EAGER=false
JOB_MAX_RETRIES=3
JOB_RETRY_SECONDS=5
# The organisation whose admins read the leads of the public site
# LEADS_ORG_ID=
LEAD_RATE_LIMIT=5/minute

# --- Billing and analytics (Phase 12) ---
# Cache for the metrics endpoints (60 seconds). Empty: in-memory cache of the API process.
# CACHE_URL=redis://127.0.0.1:6380/1

# --- Frontend (Phase 13), set in frontend/.env.local when needed ---
# VITE_API_PROXY=http://127.0.0.1:8000   # where `npm run dev` forwards /api
# VITE_API_BASE=                          # leave empty to call the same origin
