          "bodySize": 1522,
          "content": {
            "mimeType": "text/html",
            "size": 1522,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Request a quote - Northbridge Business</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body><main><h1>Request a quote</h1><p>Tell us about your business and we will get back to you.</p>\n<form id=\"web_to_lead\" method=\"post\" action=\"/index.php?entryPoint=WebToLeadCapture\">\n<p><label for=\"f_first_name\">First name</label> <input type=\"text\" name=\"first_name\" id=\"f_first_name\" autocomplete=\"given-name\" required></p>\n<p><label for=\"f_last_name\">Last name</label> <input type=\"text\" name=\"last_name\" id=\"f_last_name\" autocomplete=\"family-name\" required></p>\n<p><label for=\"f_email1\">Work email</label> <input type=\"email\" name=\"email1\" id=\"f_email1\" autocomplete=\"email\" required></p>\n<p><label for=\"f_phone_work\">Work phone</label> <input type=\"tel\" name=\"phone_work\" id=\"f_phone_work\" autocomplete=\"tel\"></p>\n<p><label for=\"f_account_name\">Company</label> <input type=\"text\" name=\"account_name\" id=\"f_account_name\" autocomplete=\"organization\"></p>\n<p><label for=\"f_title\">Job title</label> <input type=\"text\" name=\"title\" id=\"f_title\" autocomplete=\"organization-title\"></p>\n<input type=\"hidden\" name=\"lead_source\" id=\"f_lead_source\" value=\"\">\n<p><label for=\"f_description\">How can we help?</label> <textarea name=\"description\" id=\"f_description\"></textarea></p>\n<button type=\"submit\">Submit</button></form>\n</main>\n<script src=\"https://crm.northbridge.example/include/javascript/webtolead.js\"></script>\n</body></html>"
          },
