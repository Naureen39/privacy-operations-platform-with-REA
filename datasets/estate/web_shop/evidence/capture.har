        "response": {
          "bodySize": 2508,
          "content": {
            "mimeType": "text/html",
            "size": 2508,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Checkout - Northbridge Shop</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600&amp;display=swap\">\n</head>\n<body><main><h1>Checkout</h1><p>Enter your details to complete the order.</p>\n<form id=\"checkout\" method=\"post\" action=\"/?wc-ajax=checkout\">\n<p><label for=\"f_billing_first_name\">First name</label> <input type=\"text\" name=\"billing_first_name\" id=\"f_billing_first_name\" autocomplete=\"given-name\" required></p>\n<p><label for=\"f_billing_last_name\">Last name</label> <input type=\"text\" name=\"billing_last_name\" id=\"f_billing_last_name\" autocomplete=\"family-name\" required></p>\n<p><label for=\"f_billing_email\">Email address</label> <input type=\"email\" name=\"billing_email\" id=\"f_billing_email\" autocomplete=\"email\" required></p>\n<p><label for=\"f_billing_phone\">Phone</label> <input type=\"tel\" name=\"billing_phone\" id=\"f_billing_phone\" autocomplete=\"tel\"></p>\n<p><label for=\"f_billing_address_1\">Street address</label> <input type=\"text\" name=\"billing_address_1\" id=\"f_billing_address_1\" autocomplete=\"address-line1\" required></p>\n<p><label for=\"f_billing_city\">Town / City</label> <input type=\"text\" name=\"billing_city\" id=\"f_billing_city\" autocomplete=\"address-level2\" required></p>\n<p><label for=\"f_billing_postcode\">Postcode</label> <input type=\"text\" name=\"billing_postcode\" id=\"f_billing_postcode\" autocomplete=\"postal-code\" required></p>\n<p><label for=\"f_billing_country\">Country</label> <input type=\"text\" name=\"billing_country\" id=\"f_billing_country\" autocomplete=\"country\" required></p>\n<p><label for=\"f_billing_birthdate\">Date of birth</label> <input type=\"date\" name=\"billing_birthdate\" id=\"f_billing_birthdate\" autocomplete=\"bday\"></p>\n<p><label for=\"f_account_password\">Create account password</label> <input type=\"password\" name=\"account_password\" id=\"f_account_password\" autocomplete=\"new-password\"></p>\n<p><label for=\"f_marketing_optin\">Send me news and offers</label> <input type=\"checkbox\" name=\"marketing_optin\" id=\"f_marketing_optin\"></p>\n<button type=\"submit\">Place order</button></form>\n</main>\n<script src=\"https://shop.northbridge.example/wp-content/themes/northbridge/assets/app.js\"></script>\n<script src=\"https://js.stripe.com/v3/\"></script>\n<script src=\"https://connect.facebook.net/en_US/fbevents.js\"></script>\n<script src=\"https://analytics.northbridge.example/matomo.js\"></script>\n</body></html>"
          },
