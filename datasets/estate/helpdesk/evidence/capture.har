          "bodySize": 1194,
          "content": {
            "mimeType": "text/html",
            "size": 1194,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Northbridge Support</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body><main><h1>How can we help?</h1><p>Start a chat or send us a message.</p>\n<form id=\"widget_conversation\" method=\"post\" action=\"/api/v1/widget/conversations\" data-format=\"json\">\n<p><label for=\"f_contact_name\">Your name</label> <input type=\"text\" name=\"contact.name\" id=\"f_contact_name\" autocomplete=\"name\" required></p>\n<p><label for=\"f_contact_email\">Email</label> <input type=\"email\" name=\"contact.email\" id=\"f_contact_email\" autocomplete=\"email\" required></p>\n<p><label for=\"f_contact_phone_number\">Phone (optional)</label> <input type=\"tel\" name=\"contact.phone_number\" id=\"f_contact_phone_number\" autocomplete=\"tel\"></p>\n<p><label for=\"f_message_subject\">Subject</label> <input type=\"text\" name=\"message.subject\" id=\"f_message_subject\"></p>\n<p><label for=\"f_message_content\">Message</label> <textarea name=\"message.content\" id=\"f_message_content\" required></textarea></p>\n<button type=\"submit\">Send</button></form>\n</main>\n<script src=\"https://support.northbridge.example/packs/js/sdk.js\"></script>\n</body></html>"
          },
