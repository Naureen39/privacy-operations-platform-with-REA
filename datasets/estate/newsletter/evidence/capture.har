        "response": {
          "bodySize": 1316,
          "content": {
            "mimeType": "text/html",
            "size": 1316,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>Subscribe - Northbridge Newsletter</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n</head>\n<body><main><h1>Our newsletter</h1><p>News, offers and events, about twice a month.</p>\n<form id=\"subscribe\" method=\"post\" action=\"/subscribe\">\n<p><label for=\"f_email\">Email address</label> <input type=\"email\" name=\"email\" id=\"f_email\" autocomplete=\"email\" required></p>\n<p><label for=\"f_first_name\">First name</label> <input type=\"text\" name=\"first_name\" id=\"f_first_name\" autocomplete=\"given-name\"></p>\n<p><label for=\"f_phone\">Mobile phone</label> <input type=\"tel\" name=\"phone\" id=\"f_phone\" autocomplete=\"tel\"></p>\n<p><label for=\"f_postcode\">Postcode</label> <input type=\"text\" name=\"postcode\" id=\"f_postcode\" autocomplete=\"postal-code\"></p>\n<p><label for=\"f_interests\">Interests</label> <input type=\"text\" name=\"interests\" id=\"f_interests\"></p>\n<p><label for=\"f_consent_marketing\">Yes, send me marketing e-mails</label> <input type=\"checkbox\" name=\"consent_marketing\" id=\"f_consent_marketing\" checked></p>\n<button type=\"submit\">Subscribe</button></form>\n</main>\n<script src=\"https://newsletter.northbridge.example/static/subscribe.js\"></script>\n<script src=\"https://track.openpulse.example/pixel.js\"></script>\n</body></html>"
          },
          "cookies": [],
