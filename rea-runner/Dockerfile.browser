# Website observation with REA and a headless Chromium. Used by the rea-browser service, which is
# attached only to the internal demo network, runs as an unprivileged user and enforces a hard
# timeout (REA_BROWSER_TIMEOUT_SECONDS). The wrapper validates every URL again before connecting.
FROM node:24-slim

ENV NODE_ENV=production \
    REA_RUNNER_ROLE=browser \
    REA_INPUT_DIR=/input \
    CHROME_PATH=/usr/bin/chromium \
    REA_BROWSER_NO_SANDBOX=1 \
    HOME=/work \
    TMPDIR=/tmp \
    PORT=8080

RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation procps \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10002 observer \
 && useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin observer \
 && mkdir -p /opt/rea-runner /input /work \
 && chown observer:observer /work

WORKDIR /opt/rea-runner
COPY package.json package-lock.json .npmrc ./
# The package manager is only needed to install; removing it keeps its bundled copies of other
# libraries (which the runner never loads) out of the image.
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /root/.npm
COPY wrapper.mjs ./
COPY lib ./lib

USER 10002:10002
WORKDIR /work
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD node -e "fetch('http://127.0.0.1:8080/v1/health',{headers:{'x-runner-token':process.env.REA_RUNNER_TOKEN||''}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "/opt/rea-runner/wrapper.mjs", "serve"]
