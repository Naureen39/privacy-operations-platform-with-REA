# Static analysis of uploaded evidence with REA. Used by the rea-offline service, which has no
# internet access, mounts evidence read only and runs as an unprivileged user (see docker-compose.yml).
# Node 24.15 or newer is required by REA's SQLite inspection.
FROM node:24-slim

ENV NODE_ENV=production \
    REA_RUNNER_ROLE=offline \
    REA_INPUT_DIR=/input \
    HOME=/work \
    TMPDIR=/tmp \
    PORT=8080

# REA checks process ownership with a procps compatible "ps" on Linux.
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 runner \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin runner \
 && mkdir -p /opt/rea-runner /input /work \
 && chown runner:runner /work

WORKDIR /opt/rea-runner
COPY package.json package-lock.json .npmrc ./
# The lock file pins rea-agents; install scripts are disabled so nothing is downloaded at build time.
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && node -e "const v=process.versions.node.split('.').map(Number); if (v[0]<24 || (v[0]===24 && v[1]<15)) process.exit(1)"
COPY wrapper.mjs ./
COPY lib ./lib

USER 10001:10001
WORKDIR /work
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD node -e "fetch('http://127.0.0.1:8080/v1/health',{headers:{'x-runner-token':process.env.REA_RUNNER_TOKEN||''}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "/opt/rea-runner/wrapper.mjs", "serve"]
